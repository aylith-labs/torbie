h3.mb-3(translate) Color schemes

.form-line.mb-4
    .header
        .title(translate) Switch color scheme

    .btn-group(role='group')
        input.btn-check(
            type='radio',
            name='colorSchemeMode',
            [(ngModel)]='config.store.appearance.colorSchemeMode',
            (ngModelChange)='config.save()',
            id='colorSchemeModeAuto',
            [value]='"auto"'
        )
        label.btn.btn-secondary(
            for='colorSchemeModeAuto'
        )
            span(translate) From system
        input.btn-check(
            type='radio',
            name='colorSchemeMode',
            [(ngModel)]='config.store.appearance.colorSchemeMode',
            (ngModelChange)='config.save()',
            id='colorSchemeModeDark',
            [value]='"dark"'
        )
        label.btn.btn-secondary(
            for='colorSchemeModeDark'
        )
            span(translate) Always dark
        input.btn-check(
            type='radio',
            name='colorSchemeMode',
            [(ngModel)]='config.store.appearance.colorSchemeMode',
            (ngModelChange)='config.save()',
            id='colorSchemeModeLight',
            [value]='"light"'
        )
        label.btn.btn-secondary(
            for='colorSchemeModeLight'
        )
            span(translate) Always light

.form-line.mb-4
    .header
        .title(translate) Generate 256-color palette
        .description(translate) Generate extended 256-color palette from your base 16 colors
    toggle(
        [(ngModel)]='config.store.terminal.paletteGenerate',
        (ngModelChange)='config.save()'
    )

.form-line.mb-4
    .header
        .title(translate) Harmonious palette
        .description(translate) Whether to invert generated light theme colors. This helps give the 256-color palette more semantic meaning.
    toggle(
        [(ngModel)]='config.store.terminal.paletteHarmonious',
        (ngModelChange)='config.save()'
    )

//- One search for all three tabs, placed above them so it reads as applying to
//- whichever is open. Each list takes it as its `filter` input. `.content-box`
//- gives it the lists' width, so its edges line up with theirs.
.content-box.mb-3
    .input-group
        .input-group-text
            i.fas.fa-fw.fa-search
        input.form-control(
            type='search',
            [placeholder]='"Search color schemes"|translate',
            [attr.aria-label]='"Search color schemes"|translate',
            [(ngModel)]='filter'
        )

ul.nav-tabs(ngbNav, #nav='ngbNav', [activeId]='activeTab')
    li(ngbNavItem='pair')
        a(ngbNavLink, translate) Pair
        ng-template(ngbNavContent)
            color-scheme-pairs([filter]='filter')

    li(ngbNavItem='dark')
        a(ngbNavLink, translate) Dark mode
        ng-template(ngbNavContent)
            color-scheme-settings-for-mode(configKey='colorScheme', [filter]='filter')

    li(ngbNavItem='light')
        a(ngbNavLink, translate) Light mode
        ng-template(ngbNavContent)
            color-scheme-settings-for-mode(configKey='lightColorScheme', [filter]='filter')

div([ngbNavOutlet]='nav')
