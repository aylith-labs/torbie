{
  "extends": "../tsconfig.json",
  "exclude": ["node_modules", "dist", "typings"],
  "compilerOptions": {
    // TypeScript 6 turns two long-standing deprecations into errors here.
    // `baseUrl` is kept rather than removed: every `paths` entry below is
    // written relative to it, and dropping it silently re-bases them on this
    // file instead of on src/ — which resolves one directory too high and loses
    // every shared dependency. `rootDir` simply has to be stated now.
    "ignoreDeprecations": "6.0",
    "baseUrl": "src",
    // Not "src": this package imports `configPath` from app/lib/config, so its
    // common source directory is the repo root. TypeScript 6 requires the value
    // to be stated, and this is the one it used to infer — the emitted layout is
    // unchanged.
    "rootDir": "..",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./typings",
    "paths": {
      "tabby-*": ["../../tabby-*"],
      "*": ["../../app/node_modules/*"]
    }
  }
}
