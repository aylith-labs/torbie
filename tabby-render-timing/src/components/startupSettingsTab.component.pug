h3.mb-2(translate) Startup & lifecycle

.text-muted.mb-3(translate) Every mark this run recorded, from the process starting to the first terminal printing and everything after — main process and each window — and the launches before it.

.alert.alert-info(*ngIf='loading')
    i.fas.fa-fw.fa-circle-notch.fa-spin.me-2
    span(translate) Reading the timeline…

.alert.alert-warning(*ngIf='unavailable')
    span(translate) This build does not record a lifecycle timeline.

ng-container(*ngIf='!loading && snapshot && selected')
    //- Tab labels stay fixed text: settings search finds an inner tab again
    //- by its label, so a count or a date in one would strand its results.
    ul.nav-tabs(ngbNav, #nav='ngbNav', [activeId]='activeTab', (activeIdChange)='setTab($event)')
        li(ngbNavItem='launch')
            a(ngbNavLink, draggable='false')
                i.fas.fa-fw.fa-chart-gantt.me-2
                span(translate) Waterfall
                i.fas.fa-fw.fa-clock-rotate-left.ms-2.past-mark(
                    *ngIf='!isCurrent',
                    [attr.title]='"Showing an earlier launch"|translate'
                )
            ng-template(ngbNavContent)
                ng-container(*ngTemplateOutlet='waterfallTab')

        li(ngbNavItem='after')
            a(ngbNavLink, draggable='false')
                i.fas.fa-fw.fa-list-ul.me-2
                span(translate) After the boot
            ng-template(ngbNavContent)
                ng-container(*ngTemplateOutlet='afterTab')

        li(ngbNavItem='history')
            a(ngbNavLink, draggable='false')
                i.fas.fa-fw.fa-clock-rotate-left.me-2
                span(translate) Launches
            ng-template(ngbNavContent)
                ng-container(*ngTemplateOutlet='historyTab')

    div([ngbNavOutlet]='nav')

// ── Which launch the waterfall and the later list are drawing ──────────────

ng-template(#launchBanner)
    .viewing-past.mb-3(*ngIf='!isCurrent', role='status')
        i.fas.fa-fw.fa-clock-rotate-left
        .viewing-text
            strong(translate) Showing an earlier launch
            span.meta
                | {{selected.startedAt | date:'medium'}} · {{selected.version}} · {{selected.packaged ? 'packaged' : 'source'}}{{selected.dev ? ' (dev)' : ''}} · pid {{selected.pid}}
        button.btn.btn-sm.btn-primary((click)='backToCurrent()')
            i.fas.fa-fw.fa-rotate-left.me-1
            span(translate) Back to this launch

// ── Waterfall ──────────────────────────────────────────────────────────────

ng-template(#waterfallTab)
    ng-container(*ngTemplateOutlet='launchBanner')

    .summaries.mb-3
        .summary(*ngFor='let s of summaries')
            .value {{formatMs(s.value)}}
            .label {{s.label}}
            .hint {{s.hint}}
            .delta([class]='deltaClass(s)', *ngIf='delta(s)') {{delta(s)}}

    .toolbar.mb-2
        .launch
            h4.launch-title(*ngIf='isCurrent', translate) This launch
            h4.launch-title(*ngIf='!isCurrent') {{selected.startedAt | date:'medium'}}
            span.meta(*ngIf='isCurrent')
                | {{selected.version}} · {{selected.packaged ? 'packaged' : 'source'}}{{selected.dev ? ' (dev)' : ''}} · pid {{selected.pid}}
        .controls
            .btn-group.btn-group-sm
                button.btn([class.btn-primary]='scope === "boot"', [class.btn-secondary]='scope !== "boot"', (click)='setScope("boot")', translate) Boot
                button.btn([class.btn-primary]='scope === "all"', [class.btn-secondary]='scope !== "all"', (click)='setScope("all")', translate) Whole run
            button.btn.btn-sm.btn-secondary.ms-2((click)='togglePlugins()')
                i.fas.fa-fw.me-1([class.fa-square-check]='showPlugins', [class.fa-square]='!showPlugins')
                span(translate) Plugin loads
            button.btn.btn-sm.btn-secondary.ms-2((click)='refresh()')
                i.fas.fa-fw.fa-rotate.me-1
                span(translate) Refresh
            button.btn.btn-sm.btn-secondary.ms-2((click)='copy()')
                i.fas.fa-fw.fa-copy.me-1
                span(translate) Copy JSON

    .waterfall
        .wf-head
            .wf-label(translate) Event
            .wf-proc(translate) Process
            .wf-at(translate) At
            .wf-dur(translate) Took
            .wf-track
                .tick(*ngFor='let t of ticks', [style.left]='left(t)') {{formatMs(t)}}
        .wf-row(*ngFor='let row of rows; trackBy: trackRow', [class]='"type-" + row.type + " role-" + row.role', [attr.title]='row.detail || null')
            .wf-label
                span.dot
                span.text {{row.label}}
            .wf-proc {{process(row)}}
            .wf-at {{at(row)}}
            .wf-dur {{row.duration ? formatMs(row.duration) : ''}}
            .wf-track
                .grid(*ngFor='let t of ticks', [style.left]='left(t)')
                .bar(*ngIf='row.duration', [style.left]='left(row.start)', [style.width]='width(row)')
                .pin(*ngIf='!row.duration', [style.left]='left(row.start)')
        .empty.text-muted(*ngIf='!rows.length', translate) Nothing recorded.

    .legend
        span.key.type-phase
            span.swatch
            span(translate) phase (until the next one in that process)
        span.key.type-timed
            span.swatch
            span(translate) timed operation
        span.key.type-stall
            span.swatch
            span(translate) event loop blocked
        span.key.type-failure
            span.swatch
            span(translate) failure
        span.key.role-main
            span.swatch.outline
            span(translate) main process
        span.key.role-renderer
            span.swatch.outline
            span(translate) window

// ── After the boot ─────────────────────────────────────────────────────────

ng-template(#afterTab)
    ng-container(*ngTemplateOutlet='launchBanner')

    .tab-intro.mb-2
        h4(translate) After the boot
        span.meta(translate) What happened once the first terminal printed, newest first. Hover a row for its detail.

    .later(*ngIf='later.length')
        .later-row.later-head
            span.clock(translate) Time
            span.at(translate) At
            span.what(translate) Event
            span.proc(translate) Process
            span.took(translate) Took
        .later-row(*ngFor='let row of later; trackBy: trackRow', [class]='"type-" + row.type', [attr.title]='row.detail || null')
            span.clock {{clock(row)}}
            span.at {{at(row)}}
            span.what
                span.dot
                span.text {{row.label}}
            span.proc {{process(row)}}
            span.took {{row.duration ? formatMs(row.duration) : ''}}
    .later.empty.text-muted(*ngIf='!later.length', translate) Nothing has happened since the boot yet.

    .legend(*ngIf='later.length')
        span.key.type-phase
            span.swatch
            span(translate) phase
        span.key.type-timed
            span.swatch
            span(translate) timed operation
        span.key.type-stall
            span.swatch
            span(translate) event loop blocked
        span.key.type-failure
            span.swatch
            span(translate) failure

// ── Launches ───────────────────────────────────────────────────────────────

ng-template(#historyTab)
    .tab-intro.mb-2
        h4(translate) Launches
        span.meta(translate) Kept in launch-history.json beside diagnostics.log. Click one to see its waterfall.

    .history
        .h-row.h-head
            .h-when(translate) Started
            .h-build(translate) Build
            .h-num(translate) Shown
            .h-num(translate) Ready
            .h-num(translate) Output
            .h-bar(translate) Stages
        .h-row(
            *ngFor='let h of history; trackBy: trackHistory',
            [class.current]='h.current',
            [class.selected]='h.record.id === selected.id',
            [attr.aria-current]='h.record.id === selected.id ? "true" : null',
            role='button',
            tabindex='0',
            (click)='openLaunch(h.record)',
            (keydown.enter)='openLaunch(h.record)',
            (keydown.space)='$event.preventDefault(); openLaunch(h.record)',
        )
            .h-when
                span {{h.when | date:'MMM d, HH:mm:ss'}}
                span.badge.ms-1(*ngIf='h.current', translate) now
                span.badge.shown.ms-1(*ngIf='h.record.id === selected.id && !h.current', translate) shown
            .h-build {{h.record.version}} · {{h.record.packaged ? 'packaged' : 'source'}}
            .h-num {{formatMs(h.shown)}}
            .h-num {{formatMs(h.ready)}}
            .h-num {{formatMs(h.output)}}
            .h-bar
                .seg(
                    *ngFor='let s of h.stages',
                    [class]='"stage-" + s.id',
                    [style.left]='left(s.start, historyScale)',
                    [style.width]='width(s, historyScale)',
                    [attr.title]='s.label + ": " + formatMs(s.duration)',
                )
    .legend
        span.key.stage-electron
            span.swatch
            span(translate) process → Electron ready
        span.key.stage-window
            span.swatch
            span(translate) → window on screen
        span.key.stage-boot
            span.swatch
            span(translate) → app ready
        span.key.stage-tab
            span.swatch
            span(translate) → PTY spawned
        span.key.stage-terminal
            span.swatch
            span(translate) → first output
