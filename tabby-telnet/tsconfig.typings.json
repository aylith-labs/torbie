{
  "extends": "../tsconfig.json",
  "exclude": [
    "node_modules",
    "dist",
    "typings"
  ],
  "include": [
    "src"
  ],
  "compilerOptions": {
    "rootDir": "src",
    "emitDeclarationOnly": true,
    "declaration": true,
    "declarationDir": "./typings",
    "paths": {
      "tabby-*": [
        "./../tabby-*"
      ],
      "*": [
        "./../app/node_modules/*"
      ]
    }
  }
}
