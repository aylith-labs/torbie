.d-flex.mb-3
    h3(translate) Plugins
    button.btn.btn-secondary.btn-sm.ms-auto((click)='openPluginsFolder()')
        i.fas.fa-folder
        span(translate) Plugins folder

.alert.alert-danger(*ngIf='errorMessage')
    strong(
        translate='Error in {plugin}:',
        [translateParams]='{plugin: erroredPlugin}'
    )
    pre {{errorMessage}}

ul.nav-tabs.mb-2(ngbNav, #nav='ngbNav')
    li(ngbNavItem)
        a(ngbNavLink, translate) Available
        ng-template(ngbNavContent)
            //- The query never goes to the registry, which ignores it: the whole
            //- catalogue is fetched once and searched here (pluginSearch.ts).
            .plugin-toolbar.mb-3.mt-3
                .input-group.plugin-search
                    .input-group-text
                        i.fas.fa-fw.fa-circle-notch.fa-spin(*ngIf='catalogueLoading')
                        i.fas.fa-fw.fa-search(*ngIf='!catalogueLoading')
                    input.form-control(
                        type='text',
                        [ngModel]='availableFilter',
                        (ngModelChange)='searchAvailable($event)',
                        [placeholder]='"Search plugins"|translate',
                        [attr.aria-label]='"Search plugins"|translate'
                    )
                .input-group.plugin-sort
                    .input-group-text
                        i.fas.fa-fw.fa-arrow-down-wide-short
                    select.form-control(
                        [ngModel]='sort.available',
                        (ngModelChange)='sortAvailable($event)',
                        [attr.aria-label]='"Sort plugins"|translate'
                    )
                        option(value='relevance', translate) Relevance
                        option(value='downloads', translate) Most downloaded
                        option(value='published', translate) Recently published
                        option(value='name', translate) Name

            .alert.plugin-alert(*ngIf='catalogueError', role='alert')
                i.fas.fa-fw.fa-triangle-exclamation(aria-hidden='true')
                div
                    strong.d-block(translate) Could not load plugins from the npm registry
                    small.d-block.text-muted {{catalogueError}}
                button.btn.btn-secondary.btn-sm.ms-auto(
                    (click)='loadCatalogue(true)',
                    [disabled]='catalogueLoading',
                    translate
                ) Retry

            //- The directive accordion, not `<ngb-accordion>`: that component
            //- and its `ngb-panel` were removed in ng-bootstrap 15 and this
            //- tree is on 21, so the markup resolved to nothing and both lists
            //- rendered empty — with no error, because unknown elements are
            //- not an error.
            div.mb-4(
                ngbAccordion,
                [closeOthers]='true',
                [animation]='config.store.accessibility.animations'
            )
                .accordion-item(ngbAccordionItem, *ngFor='let plugin of availablePlugins; trackBy: trackPlugin')
                    .accordion-header(ngbAccordionHeader)
                        button.accordion-button(ngbAccordionButton, type='button')
                            .text-left
                                strong.d-block {{plugin.name}}
                                small.d-block.text-muted {{plugin.description}}
                                //- What the sort options order by, so an order can be read.
                                small.d-block.text-muted.plugin-stats
                                    span(
                                        translate='Monthly downloads: {count}',
                                        [translateParams]='{count: formatCount(plugin.monthlyDownloads)}'
                                    )
                                    //- `&ngsp;` survives Angular's whitespace removal. Margins
                                    //- alone left the text as "3,232Published" to anything that
                                    //- reads it rather than looks at it.
                                    ng-container(*ngIf='plugin.published')
                                        | &ngsp;
                                        span.mx-1(aria-hidden='true') ·
                                        | &ngsp;
                                        span(
                                            translate='Published: {date}',
                                            [translateParams]='{date: formatDate(plugin.published)}'
                                        )
                    .accordion-collapse(ngbAccordionCollapse)
                        .accordion-body(ngbAccordionBody)
                            ng-template
                                .d-flex.flex-column.flex-md-row.gap-3.align-items-start
                                    button.btn.btn-primary.btn-block.justify-content-center(
                                        (click)='installPlugin(plugin)',
                                        [disabled]='busy.has(plugin.name)'
                                    )
                                        i.fas.fa-fw.fa-cloud-download(*ngIf='busy.get(plugin.name) != BusyState.Installing')
                                        i.fas.fa-fw.fa-circle-notch.fa-spin(*ngIf='busy.get(plugin.name) == BusyState.Installing')
                                        span.ms-2(translate) Get

                                    button.btn.btn-secondary.btn-block.justify-content-center(
                                        *ngIf='plugin.homepage',
                                        (click)='showPluginHomepage(plugin)'
                                    )
                                        i.fas.fa-fw.fa-external-link-alt
                                        span.ms-2(translate) Homepage

                                    .ms-auto
                                    div
                                        ng-container(*ngTemplateOutlet='pluginInfo; context: { plugin }')

            .text-muted.text-center.py-4(*ngIf='catalogue && !availablePlugins.length', translate)
                | Nothing found

    li(ngbNavItem)
        a(ngbNavLink, translate) Installed
        ng-template(ngbNavContent)
            .plugin-toolbar.mb-3.mt-3
                .input-group.plugin-search
                    .input-group-text
                        i.fas.fa-fw.fa-search
                    input.form-control(
                        type='text',
                        [ngModel]='installedFilter',
                        (ngModelChange)='searchInstalled($event)',
                        [placeholder]='"Search plugins"|translate',
                        [attr.aria-label]='"Search plugins"|translate'
                    )
                .input-group.plugin-sort
                    .input-group-text
                        i.fas.fa-fw.fa-arrow-down-wide-short
                    select.form-control(
                        [ngModel]='sort.installed',
                        (ngModelChange)='sortInstalled($event)',
                        [attr.aria-label]='"Sort plugins"|translate'
                    )
                        option(value='name', translate) Name
                        option(value='thirdParty', translate) Third-party first
                        option(value='disabled', translate) Disabled first

            //- Same migration as the Available list above. The Upgrade button is
            //- a sibling of the toggle rather than a child of it: the component
            //- API rendered `ngbPanelTitle` *inside* the header button, so this
            //- was a button nested in a button, which is invalid and swallows
            //- the inner click in some browsers.
            div.mb-4(
                ngbAccordion,
                [closeOthers]='true',
                [animation]='config.store.accessibility.animations'
            )
                .accordion-item(ngbAccordionItem, *ngFor='let plugin of installedPlugins; trackBy: trackPlugin')
                    .accordion-header.plugin-header(ngbAccordionHeader)
                        button.accordion-button(ngbAccordionButton, type='button')
                            .text-left
                                div
                                    strong {{plugin.name}}
                                    small.text-muted.ms-2(*ngIf='plugin.isBuiltin', translate) Built-in
                                    small.text-warning.ms-2(*ngIf='!isPluginEnabled(plugin)', translate) Disabled
                                small.d-block.text-muted {{plugin.description}}

                        button.btn.btn-primary.upgrade-button(
                            *ngIf='knownUpgrades[plugin.name]',
                            (click)='upgradePlugin(plugin)',
                            [disabled]='busy.has(plugin.name)'
                        )
                            i.fas.fa-fw.fa-arrow-up(*ngIf='busy.get(plugin.name) != BusyState.Installing')
                            i.fas.fa-fw.fa-circle-notch.fa-spin(*ngIf='busy.get(plugin.name) == BusyState.Installing')
                            span(
                                translate='Upgrade to {version}',
                                [translateParams]='{version: knownUpgrades[plugin.name]?.version}'
                            )

                    .accordion-collapse(ngbAccordionCollapse)
                        .accordion-body(ngbAccordionBody)
                            ng-template
                                .d-flex.flex-column.flex-md-row.gap-3.align-items-start
                                    button.btn.btn-warning.btn-block.justify-content-center(
                                        (click)='togglePlugin(plugin)',
                                        *ngIf='isPluginEnabled(plugin)',
                                        [disabled]='!canDisablePlugin(plugin)',
                                        translate
                                    ) Disable

                                    button.btn.btn-success.btn-block.justify-content-center(
                                        (click)='togglePlugin(plugin)',
                                        *ngIf='canDisablePlugin(plugin) && !isPluginEnabled(plugin)',
                                        translate
                                    ) Enable

                                    button.btn.btn-danger.btn-block.justify-content-center(
                                        (click)='uninstallPlugin(plugin)',
                                        *ngIf='!plugin.isBuiltin',
                                        [disabled]='busy.has(plugin.name)'
                                    )
                                        i.fas.fa-fw.fa-trash(*ngIf='busy.get(plugin.name) != BusyState.Uninstalling')
                                        i.fas.fa-fw.fa-circle-notch.fa-spin(*ngIf='busy.get(plugin.name) == BusyState.Uninstalling')
                                        span(translate) Uninstall

                                    .ms-auto
                                    div
                                        ng-container(*ngTemplateOutlet='pluginInfo; context: { plugin }')

            .text-muted.text-center.py-4(*ngIf='!installedPlugins.length', translate)
                | Nothing found

ng-template(#pluginInfo, let-plugin='plugin')
    .d-flex.align-items-center.gap-3
        strong(translate) Version
        span {{plugin.version}}
    .d-flex.align-items-center.gap-3
        strong(translate) Author
        .badge.text-bg-success(*ngIf='plugin.isOfficial')
            i.fas.fa-check
            span.ms-1(translate) Official
        a.btn.btn-link.px-0.w-auto((click)='showPluginInfo(plugin)', *ngIf='!plugin.isOfficial')
            span {{plugin.author}}
            i.fas.fa-fw.fa-external-link-alt.ms-2

.mb-4([ngbNavOutlet]='nav')
