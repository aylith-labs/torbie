{
  "compilerOptions": {
    // TypeScript 6 turns `strict` on by default. This project never wanted it —
    // it sets `noImplicitAny: false` and opts into `strictNullChecks` on its
    // own — and inheriting the new default lights up ~60 property-initialisation
    // errors across the API classes, which are DI-populated by design. Stated
    // explicitly so the posture is a choice rather than a version artefact.
    "strict": false,
    // Likewise no longer inferred: without this, `Buffer` and the rest of the
    // node globals are unresolved in every package.
    "types": ["node"],
    // Angular 22, @angular/cdk and ng-bootstrap 21 all publish their
    // subpaths through an "exports" map — `@angular/cdk/drag-drop`,
    // `@ng-bootstrap/ng-bootstrap/modal`, `@angular/platform-browser/animations`.
    // `moduleResolution: node` predates that field and cannot see any of them,
    // which surfaces as "has no exported member NgbModal" rather than as a
    // resolution error, so it reads like an API change and is not one.
    "module": "esnext",
    "target": "es2022",
    "moduleResolution": "bundler",
    // `target: es2022` turns this on by default, which changes what a class
    // field *is*: [[Define]] on the instance before the constructor body runs,
    // rather than an assignment inside it. Angular code leans on the old
    // semantics everywhere — a field initializer that calls
    // `this.translate.instant(...)`, where `translate` is a constructor
    // parameter property, is 64 of the 65 errors this produced. Angular's own
    // generated tsconfig sets it false for the same reason.
    "useDefineForClassFields": false,
    "noImplicitAny": false,
    "removeComments": false,
    "emitDeclarationOnly": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ES2015",
      "ES2017",
      "ES2019",
      "ES2021",
      // Object.hasOwn, used in profiles.service.ts.
      "ES2022"
    ],
    "paths": {
      "*": [
        "../node_modules/*",
        "../../app/node_modules/*",
        "./app/node_modules/*"
      ],
      "tabby-*": ["../../tabby-*/src"],
    }
  },
  "typeAcquisition": {
    "include": [
      "../node_modules",
      "../../app/node_modules"
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "enableResourceInlining": true,
    "strictInjectionParameters": true,
  },
}
