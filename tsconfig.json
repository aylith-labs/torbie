{
  "compilerOptions": {
    // TypeScript 6 turns `strict` on by default. This project never wanted it —
    // it sets `noImplicitAny: false` and opts into `strictNullChecks` on its
    // own — and inheriting the new default lights up ~60 property-initialisation
    // errors across the API classes, which are DI-populated by design. Stated
    // explicitly so the posture is a choice rather than a version artefact.
    "strict": false,
    // Likewise no longer inferred: without this, `Buffer` and the rest of the
    // node globals are unresolved in every package.
    "types": ["node"],
    // Angular 22, @angular/cdk and ng-bootstrap 21 all publish their
    // subpaths through an "exports" map — `@angular/cdk/drag-drop`,
    // `@ng-bootstrap/ng-bootstrap/modal`, `@angular/platform-browser/animations`.
    // `moduleResolution: node` predates that field and cannot see any of them,
    // which surfaces as "has no exported member NgbModal" rather than as a
    // resolution error, so it reads like an API change and is not one.
    "module": "esnext",
    // es2016, not later: the last target that compiles `async`/`await` down
    // to generators over the global `Promise`, which zone.js has replaced.
    // From es2017 on, `await` is native, and zone.js cannot see through it —
    // every continuation after the first `await` runs in the root zone, so
    // whatever it changes waits for some unrelated event to trigger change
    // detection. That was the "huge delay" opening the first tab: the tab was
    // added in `<root>` after `TerminalService.openTab` awaited the profile,
    // and its view was not created until the next zone task, 6–30s later
    // (measured: 30.6s in a hidden window, 11.7s in the user's visible one).
    // Upstream is on es2016 for the same reason; Angular CLI keeps es2022 only
    // because it downlevels async/await separately, which this build does not.
    "target": "es2016",
    "moduleResolution": "bundler",
    // `target: es2022` turns this on by default, which changes what a class
    // field *is*: [[Define]] on the instance before the constructor body runs,
    // rather than an assignment inside it. Angular code leans on the old
    // semantics everywhere — a field initializer that calls
    // `this.translate.instant(...)`, where `translate` is a constructor
    // parameter property, is 64 of the 65 errors this produced. Angular's own
    // generated tsconfig sets it false for the same reason.
    "useDefineForClassFields": false,
    "noImplicitAny": false,
    "removeComments": false,
    "emitDeclarationOnly": false,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "sourceMap": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "importHelpers": true,
    "strictNullChecks": true,
    "lib": [
      "DOM",
      "ES5",
      "ES6",
      "ES7",
      "ES2015",
      "ES2017",
      "ES2019",
      "ES2021",
      // Object.hasOwn, used in three places in profiles.service.ts. It is an
      // ES2022 library global and this list said ES2021, so it only ever
      // compiled because some transitive @types package happened to declare
      // it — removing ESLint took that package out of the tree and the build
      // went red on code nobody had touched. Stated properly now.
      "ES2022"
    ],
    "paths": {
      "*": [
        "../node_modules/*",
        "../../app/node_modules/*",
        "./app/node_modules/*"
      ],
      "tabby-*": ["../../tabby-*/src"],
    }
  },
  "typeAcquisition": {
    "include": [
      "../node_modules",
      "../../app/node_modules"
    ]
  },
  "angularCompilerOptions": {
    "strictTemplates": true,
    "enableResourceInlining": true,
    "strictInjectionParameters": true,
  },
}
