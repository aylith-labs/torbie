doctype html
html.torbie
    head
        meta(charset='UTF-8')
        base(href='index.html')
        script.
            console.timeStamp('index')
            window.nodeRequire = require
        script(src='./preload.js')
        script(src='./bundle.js', defer)
        style.
            body { transition: 0.5s background; }
    body
        style#custom-css
        root
        app-root
            .preload-logo
                div
                    .torbie-logo
                    h1.torbie-title
                        span.torbie-name(tabindex='0', aria-haspopup='true', aria-expanded='false', aria-describedby='splash-build') Torbie
                    .torbie-version
                    .progress
                        .bar(style='width: 0%')
                    .splash-build#splash-build(role='tooltip', hidden)
            script.
                window.torbieSplash && window.torbieSplash()
